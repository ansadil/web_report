{
  "name": "@reports-web/convex",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansadil/web_report.git",
    "directory": "packages/convex"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@reports-web/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "@reports-web/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec eslint packages/convex/src",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "convex": "^1.17.0"
  },
  "dependencies": {
    "@reports-web/core": "workspace:*",
    "@reports-web/shared": "workspace:*"
  },
  "devDependencies": {
    "convex": "^1.49.0",
    "convex-test": "^0.0.66",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
