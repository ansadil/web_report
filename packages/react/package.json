{
  "name": "@reports-web/react",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "sideEffects": [
    "./src/ReportViewer.tsx",
    "./src/ReportBuilder.tsx",
    "./dist/ReportViewer.js",
    "./dist/ReportBuilder.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansadil/web_report.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@reports-web/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "LICENSE", "!dist/**/*.tsbuildinfo"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec eslint packages/react/src",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@reports-web/core": "workspace:*",
    "@reports-web/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
