{
  "name": "@reports-web/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@reports-web/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viewer": {
      "@reports-web/source": "./src/components/reports-viewer.ts",
      "types": "./dist/components/reports-viewer.d.ts",
      "import": "./dist/components/reports-viewer.js"
    },
    "./builder": {
      "@reports-web/source": "./src/components/reports-builder.ts",
      "types": "./dist/components/reports-builder.d.ts",
      "import": "./dist/components/reports-builder.js"
    },
    "./adapters/data/*": {
      "@reports-web/source": "./src/adapters/data/*.ts",
      "types": "./dist/adapters/data/*.d.ts",
      "import": "./dist/adapters/data/*.js"
    },
    "./exporters/*": {
      "@reports-web/source": "./src/exporters/*.ts",
      "types": "./dist/exporters/*.d.ts",
      "import": "./dist/exporters/*.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./viewer": {
        "types": "./dist/components/reports-viewer.d.ts",
        "import": "./dist/components/reports-viewer.js"
      },
      "./builder": {
        "types": "./dist/components/reports-builder.d.ts",
        "import": "./dist/components/reports-builder.js"
      },
      "./adapters/data/*": {
        "types": "./dist/adapters/data/*.d.ts",
        "import": "./dist/adapters/data/*.js"
      },
      "./exporters/*": {
        "types": "./dist/exporters/*.d.ts",
        "import": "./dist/exporters/*.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-render-code.mjs && node scripts/copy-pdf-fonts.mjs",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest",
    "test:run": "vitest run",
    "test:qa": "vitest run --config vitest.qa.config.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@reports-web/shared": "workspace:*",
    "bidi-js": "^1.0.3",
    "chart.js": "^4.5.0",
    "exceljs": "^4.4.0",
    "harfbuzzjs": "1.6.4",
    "html-to-image": "^1.11.13",
    "jsbarcode": "^3.12.3",
    "lit": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.0",
    "happy-dom": "^15.11.7",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
