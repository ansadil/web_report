{
  "name": "@reports-web/vue",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "sideEffects": [
    "./src/ReportViewer.ts",
    "./src/ReportBuilder.ts",
    "./dist/ReportViewer.js",
    "./dist/ReportBuilder.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansadil/web_report.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@reports-web/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "LICENSE", "!dist/**/*.tsbuildinfo"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec eslint packages/vue/src",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@reports-web/core": "workspace:*",
    "@reports-web/shared": "workspace:*"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.13",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
