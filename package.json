{
  "name": "reports-web",
  "private": true,
  "version": "0.1.0",
  "description": "Embeddable reporting tool for web projects (Laravel, Next.js, any host).",
  "license": "UNLICENSED",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansadil/web_report.git",
    "directory": "."
  },
  "type": "module",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --filter=./packages/* run build",
    "test": "pnpm -r --filter=./packages/* run test:run",
    "test:run": "pnpm -r --filter=./packages/* run test:run",
    "typecheck": "pnpm -r --workspace-concurrency=1 --filter=./packages/* run typecheck",
    "lint": "pnpm -r --if-present --filter=./packages/* run lint",
    "playground": "pnpm --filter=@reports-web/playground dev",
    "clean": "pnpm -r exec rimraf dist .turbo node_modules/.vite",
    "test:qa": "pnpm --filter=@reports-web/core run test:qa"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-lit": "^2.3.1",
    "lucide": "0.545.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "^2.1.8"
  }
}
